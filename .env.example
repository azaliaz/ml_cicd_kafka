# Скопируйте в .env и заполните. Файл .env не коммитится.
DB_NAME=housing
DB_USER=housing_app
DB_PASSWORD=замените_на_сложный_пароль
DB_HOST=postgres
DB_PORT=5432
HOST_PORT=8000

# Токен dev-режима Vault (только для локальной разработки)
VAULT_TOKEN=housing-dev-root

# Сиды Vault для Kafka (см. docker/vault/entrypoint-vault.sh)
# VAULT_SEED_KAFKA_BOOTSTRAP=kafka:9092
# VAULT_SEED_KAFKA_TOPIC=housing.predictions

# Порт Redpanda (Kafka API) на хосте
# KAFKA_HOST_PORT=19092

# Имя образа для compose (опционально)
# DOCKER_IMAGE_NAME=ml-course-assignment:local
